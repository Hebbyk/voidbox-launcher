<?xml version="1.0" encoding="UTF-8"?>
<!-- Per-user MSI (no admin prompt) for the PyInstaller output in dist\VoidboxLauncher.
     Needs the WiX UI extension (build.ps1 installs it):  wix build voidbox.wxs -ext WixToolset.UI.wixext ...
     Targets the WiX v4+ schema. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Voidbox Launcher" Manufacturer="Hebby" Version="$(Version)"
           UpgradeCode="70334589-1849-4E87-8868-83B711CACECC" Scope="perUser" InstallerVersion="500">
    <MediaTemplate EmbedCab="yes" />
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of Voidbox Launcher is already installed." />

    <!-- Interface language picked on the wizard's language page: "en" or "ru". Starts at the value a
         previous install left in the registry (so upgrades keep it), else English. The launcher reads
         this registry value on first start; see i18n.py. -->
    <Property Id="APPLANGUAGE" Value="en">
      <RegistrySearch Id="PreviousLanguage" Root="HKCU" Key="Software\Hebby\VoidboxLauncher" Name="Language" Type="raw" />
    </Property>

    <Icon Id="AppIcon" SourceFile="icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <!-- Installs to %LOCALAPPDATA%\Programs\Voidbox Launcher (changeable on the options page).
         Instances and settings live in %LOCALAPPDATA%\MCLauncher and are never touched by
         install, upgrade or uninstall. -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Voidbox Launcher" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="StartMenuDir" Name="Voidbox Launcher" />
    </StandardDirectory>

    <!-- Wizard: Welcome -> language -> options (feature checkboxes + Browse for the folder) -> Ready -> Install.
         The stock license page is skipped (there is no license text to agree to). -->
    <ui:WixUI Id="WixUI_FeatureTree" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="LanguageDlg" Order="99" Condition="NOT Installed" />
      <Publish Dialog="LanguageDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" />
      <Publish Dialog="LanguageDlg" Control="Next" Event="NewDialog" Value="CustomizeDlg" />
      <Publish Dialog="CustomizeDlg" Control="Back" Event="NewDialog" Value="LanguageDlg" Order="99" Condition="NOT Installed" />
    </UI>

    <Feature Id="Main" Title="Voidbox Launcher" Level="1" AllowAbsent="no" AllowAdvertise="no"
             Display="expand" ConfigurableDirectory="INSTALLFOLDER"
             Description="The launcher itself (required). Use Browse to change where it is installed.">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="MainExe" />
      <ComponentRef Id="LanguageSetting" />
      <ComponentRef Id="LicenseFile" />
      <ComponentRef Id="NoticeFile" />
      <Feature Id="StartMenuFeature" Title="Start Menu shortcut" Level="1" AllowAdvertise="no"
               Description="Adds Voidbox Launcher to the Start menu, so you can search for it and pin it to Start or the taskbar.">
        <ComponentRef Id="StartMenuShortcut" />
      </Feature>
      <Feature Id="DesktopFeature" Title="Desktop shortcut" Level="1" AllowAdvertise="no"
               Description="Puts a Voidbox Launcher icon on your desktop.">
        <ComponentRef Id="DesktopShortcut" />
      </Feature>
    </Feature>
  </Package>

  <Fragment>
    <!-- The exe gets its own component so the shortcuts can point at it. -->
    <Component Id="MainExe" Directory="INSTALLFOLDER" Guid="*">
      <File Id="MainExeFile" Source="dist\VoidboxLauncher\Voidbox Launcher.exe" KeyPath="yes" />
    </Component>

    <!-- GPL license + copyright notice, installed next to the exe. -->
    <Component Id="LicenseFile" Directory="INSTALLFOLDER" Guid="*">
      <File Id="LicenseFileF" Source="LICENSE" KeyPath="yes" />
    </Component>
    <Component Id="NoticeFile" Directory="INSTALLFOLDER" Guid="*">
      <File Id="NoticeFileF" Source="NOTICE" KeyPath="yes" />
    </Component>

    <!-- Hands the wizard's language choice to the launcher. Removed again on uninstall. -->
    <Component Id="LanguageSetting" Directory="INSTALLFOLDER" Guid="*">
      <RegistryValue Root="HKCU" Key="Software\Hebby\VoidboxLauncher" Name="Language"
                     Type="string" Value="[APPLANGUAGE]" KeyPath="yes" />
    </Component>

    <Component Id="StartMenuShortcut" Directory="StartMenuDir" Guid="*">
      <Shortcut Id="AppShortcut" Name="Voidbox Launcher" Target="[#MainExeFile]"
                WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
      <RemoveFolder Id="RemoveStartMenuDir" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\Hebby\VoidboxLauncher" Name="startMenuShortcut"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="*">
      <Shortcut Id="DesktopShortcutLnk" Name="Voidbox Launcher" Target="[#MainExeFile]"
                WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
      <RegistryValue Root="HKCU" Key="Software\Hebby\VoidboxLauncher" Name="desktopShortcut"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- Everything else PyInstaller produced (the _internal folder etc.). -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="dist\VoidboxLauncher\**">
        <Exclude Files="dist\VoidboxLauncher\Voidbox Launcher.exe" />
      </Files>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <UI>
      <Dialog Id="LanguageDlg" Width="370" Height="270" Title="!(loc.InstallScopeDlg_Title)" KeepModeless="yes">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallScopeDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="373" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="373" Height="0" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="20" Transparent="yes" NoPrefix="yes" Text="Choose the language of the launcher. You can change it later in Settings." />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Interface language" />
        <Control Id="LanguageChoice" Type="RadioButtonGroup" X="20" Y="60" Width="330" Height="60" Property="APPLANGUAGE">
          <RadioButtonGroup Property="APPLANGUAGE">
            <RadioButton Value="en" X="0" Y="0" Width="295" Height="16" Text="English" />
            <RadioButton Value="ru" X="0" Y="24" Width="295" Height="16" Text="Russian" />
          </RadioButtonGroup>
        </Control>
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>
    </UI>
  </Fragment>
</Wix>
